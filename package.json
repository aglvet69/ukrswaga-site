{
  "name": "ukrswaga-squad-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal production-ready UKRSWAGA Squad project website with BattleMetrics status and Steam joinlobby support.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node20 --outDir dist --clean",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "update:lobby": "tsx scripts/update-lobby-from-profile.ts",
    "set:connect": "tsx scripts/set-connect-url.ts"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  }
}
